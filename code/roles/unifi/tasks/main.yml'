- name: Update apt cache
  apt:
    update_cache: yes

- name: Install dependencies
  apt:
    name:
      - ca-certificates
      - apt-transport-https
      - wget
    state: present

- name: Add UniFi repository
  copy:
    dest: /etc/apt/sources.list.d/100-ubnt-unifi.list
    content: |
      deb [ arch=amd64 ] https://www.ui.com/downloads/unifi/debian stable ubiquiti

- name: Add UniFi GPG key
  get_url:
    url: https://dl.ui.com/unifi/unifi-repo.gpg
    dest: /etc/apt/trusted.gpg.d/unifi-repo.gpg
    mode: '0644'

- name: Update apt cache again
  apt:
    update_cache: yes

- name: Install UniFi
  apt:
    name: unifi
    state: present

- name: Ensure UniFi service is running
  service:
    name: unifi
    state: started
    enabled: yes
